global_defs {
    enable_script_security
    script_user root
}

vrrp_script chk_traefik_local {
    # Keepalived simply checks if the log contains OK
    script "/usr/local/bin/parse_check.sh"
    interval 2
    fall 2       # Must fail twice consecutively to trigger failover
    rise 2       # Must pass twice consecutively to reclaim VIP
    weight 20    # Increases priority by 20 if Traefik is running on this node
}

vrrp_instance VI_1 {
    state BACKUP               # Use BACKUP on all nodes when tracking dynamic scripts
    interface eth0           # Change to your network interface name
    virtual_router_id 51
    priority ${KEEPALIVED_PRIORITY}
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass dockerkeepalived
    }

    virtual_ipaddress {
        10.0.1.248/24
    }

    track_script {
        chk_traefik_local
    }
}
